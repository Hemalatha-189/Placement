5) Longest Common substring:

def longestcommon(s):
    if not s:
        return ""
    prefix=s[0]
    for s in s[1:]:
        while not s.startswith(prefix):
            prefix=prefix[:-1]
            if prefix=="":
                return ""
    return prefix
print(longestcommon(["flower", "flow", "flight"]))

